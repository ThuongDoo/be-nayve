PORT=
NODE_ENV=
CORS_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
PUBLISH_ROOT_DOMAIN=
# This API's public address including /api (e.g. https://api.example.com/api); published forms post to it.
PUBLIC_API_URL=
STORAGE_CORS_ORIGINS=
STORAGE_LIMIT_MB=
# Frontend address (e.g. https://nayva.vn); SePay sends users back there after paying.
APP_URL=
# SePay payment gateway (my.sepay.vn → Cổng thanh toán). SEPAY_ENV: sandbox | production.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# X-Secret-Key SePay sends with IPN calls, if it differs from SEPAY_SECRET_KEY.
SEPAY_IPN_SECRET=
# Renewal prices in VND: months:price pairs (months must be 3, 6 or 12).
RENEW_PRICES=3:150000,6:270000,12:480000
